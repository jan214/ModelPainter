/* QMainWindow */
QMainWindow{
	background-color: #121212;
}

QMainWindow::separator{
	background-color: #121212;
	width: 5px;
	height: 5px;
}

QMainWindow::separator:hover{
	background-color: #444444;
}

/* QMenuBar */
QMainWindow QMenuBar{
	color: #EEEEEE;
	background-color: #121212;
}

QMainWindow QMenuBar::item:selected{
	background-color: #444444;
}

QMainWindow QMenu{
	background-color: #1E1E1E;
	padding: 0px 0px;
	margin: 0px 2px;
}

QMainWindow QMenu::item{
	color: #EEEEEE;
	background-color: #1E1E1E;
	padding: 6px 12px 6px 12px;
	margin: 0px 4px;
	border-radius: 4px;
}

QMainWindow QMenu::item:selected{
	padding: 6px 12px 6px 12px;
	margin: 0px 0px;
	background-color: #444444;
}

/* QDockWidget */
QDockWidget{
	color: #EEEEEE;
}

QDockWidget::title{
	background-color: #242424;
}

QDockWidget::title:hover{
	background-color: #444444;
}

/* BrushWidget */
#BrushWidget QScrollArea > QWidget > QWidget{
	background-color: #242424;
}

#BrushWidget ColorPickerWidget:hover{
	background-color: #444444;
	border-radius: 8px;
}

#BrushWidget ColorPickerWidget QLabel{
	color: #EEEEEE;
	margin: 4px 0px;
}

#BrushWidget SliderWidget:hover{
	background-color: #444444;
	border-radius: 8px;
}

#BrushWidget SliderWidget QLabel{
	color: #EEEEEE;
}

/* GraphicsView */
#GraphicsView QScrollBar::add-page, #GraphicsView QScrollBar::sub-page{
	background: none;
}

#GraphicsView QScrollBar{
	background-color: #242424;
	border: none;
}

#GraphicsView QScrollBar:vertical{
	border: none;
	margin-top: 0px;
	margin-bottom: 0px;
}

#GraphicsView QScrollBar:horizontal{
	border: none;
	margin-left: 0px;
	margin-right: 0px;
}

/* remove arrow buttons */
#GraphicsView QScrollBar::sub-line:vertical{
	height: 0px;
}

#GraphicsView QScrollBar::add-line:vertical{
	height: 0px;
}

#GraphicsView QScrollBar::sub-line:horizontal{
	width: 0px;
}

#GraphicsView QScrollBar::add-line:horizontal{
	width: 0px;
}

#GraphicsView QScrollBar::handle{
	background-color: #ff0000;
	border-radius: 8px;
	border: 1px solid transparent;
}

#GraphicsView QScrollBar{
	background-color: transparent;
}

#GraphicsView QScrollBar::handle:vertical{
	background-color: transparent;
}

#GraphicsView QScrollBar::handle:vertical:hover{
	background-color: #0000ff;
}

#GraphicsView QScrollBar::handle:horizontal{
	background-color: transparent;
}

#GraphicsView QScrollBar::handle:horizontal:hover{
	background-color: #0000ff;
}

/* Contact Dialog */
#ContactDialog QPushButton#CopyButton{
	background-color: transparent;
	border-radius: 4px;
}

#ContactDialog QPushButton#CopyButton::hover{
	background-color: rgba(221,221,221,125);
	border: 1px solid rgba(245,245,245,255);
}

#ContactDialog QPushButton#CopyButton{
	background-color: transparent;
	border-radius: 4px;
} 

#ContactDialog QPushButton#CopyButton::hover{
	background-color: rgba(221,221,221,125);
	border: 1px solid rgba(245,245,245,255);
}

#ContactDialog QPushButton#CloseButton{
	color: rgba(51,51,51,255);
	background-color: rgba(221,221,221,125);
	border-radius: 4px; border: 1px solid rgba(245,245,245,255);
}

#ContactDialog QPushButton#CloseButton::hover{
	color: rgba(245,245,245,255);
	background-color: rgba(56,56,56,125);
	border: 1px solid rgba(51,51,51,255);
}